{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|PowerShell|shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/luaudit-hook\"",
            "command_windows": "\"${CLAUDE_PLUGIN_ROOT}\\scripts\\luaudit-hook.cmd\"",
            "commandWindows": "\"${CLAUDE_PLUGIN_ROOT}\\scripts\\luaudit-hook.cmd\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
